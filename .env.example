# Development only. Copy to .env and replace this placeholder locally.
POSTGRES_USER=nfl_dev
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DEVELOPMENT_PASSWORD
POSTGRES_DB=nfl_research_dev

# Separate random ASCII runtime secrets (at least 24 chars), provision roles explicitly first.
API_DB_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_API_PASSWORD
INGEST_DB_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_INGEST_PASSWORD

# Opt-in prepare-only scheduler. The scheduler profile remains disabled until explicitly started.
SCHEDULER_TIMES=06:00,18:00
SCHEDULER_TIMEZONE=America/Phoenix
SCHEDULER_STATS_SCHEDULE=/data/raw/games.csv
SCHEDULER_STATS_IDENTITIES=/data/raw/team-stats-identities.json
SCHEDULER_STATS_REFERENCES=/review/docs/team-stats-gamebook-references.json
SCHEDULER_JOB_TIMEOUT_SECONDS=1200
